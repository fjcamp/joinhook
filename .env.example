# JoinHook V3 public analytics and contact configuration
# Never commit real secret values.

# Public contact
NEXT_PUBLIC_JOINHOOK_WHATSAPP=569XXXXXXXX

# Google Search Console / GA4
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Cloudflare Web Analytics
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
JOINHOOK_REQUIRE_TURNSTILE=true
JOINHOOK_REQUIRE_NEWSLETTER_TURNSTILE=false

# Contact lead destination (n8n/backend/webhook)
JOINHOOK_LEAD_WEBHOOK_URL=
JOINHOOK_REQUIRE_LEAD_WEBHOOK=true

# Privacy consent audit destination
JOINHOOK_PRIVACY_WEBHOOK_URL=

# Brevo newsletter double opt-in
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT_URL=https://joinhook.cl/newsletter-confirmada/
JOINHOOK_REQUIRE_BREVO=true

# Deployment behavior
JOINHOOK_DEPLOY_TARGET=production
