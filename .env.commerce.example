# Runtime checkout switch. Preferred on BlueHosting/cPanel because it can be
# changed without rebuilding the Next.js artifact.
JOINHOOK_COMMERCE_CHECKOUT_ENABLED=false

# Public Mercado Pago key. Safe to expose through /api/commerce/public-config.
# Preferred server-side runtime name for new deployments:
MERCADOPAGO_PUBLIC_KEY=TEST_PUBLIC_KEY_HERE
# Compatibility with earlier builds/configuration:
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST_PUBLIC_KEY_HERE

# Historical/build-time compatibility only. New deployments should use
# JOINHOOK_COMMERCE_CHECKOUT_ENABLED above.
NEXT_PUBLIC_JOINHOOK_COMMERCE_ENABLED=false

# Optional temporary fallback to the existing external Mercado Pago Link while
# embedded Commerce remains disabled. New config uses CONTROL_EXPRESS naming.
NEXT_PUBLIC_CONTROL_EXPRESS_CHECKOUT_ENABLED=true
NEXT_PUBLIC_CONTROL_EXPRESS_CHECKOUT_URL=https://YOUR_CURRENT_CHECKOUT_URL

# Server-side payment kill switch. Keep false in production until sandbox/QA is complete.
# This must be enabled independently from the checkout UI switch.
JOINHOOK_COMMERCE_ACCEPT_PAYMENTS=false

# Commerce environment: test | production
JOINHOOK_COMMERCE_ENV=test
JOINHOOK_SITE_URL=https://joinhook.cl
JOINHOOK_RELEASE_SHA=

# Mercado Pago private credentials - SERVER ONLY
MERCADOPAGO_ACCESS_TOKEN=TEST_ACCESS_TOKEN_HERE
MERCADOPAGO_WEBHOOK_SECRET=TEST_WEBHOOK_SECRET_HERE

# Dedicated JoinHook Commerce database - SERVER ONLY
JOINHOOK_COMMERCE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Preferred modern Supabase backend key. Use an sb_secret_* key and never expose it client-side.
JOINHOOK_COMMERCE_SUPABASE_SECRET_KEY=sb_secret_SERVER_ONLY_HERE
# Legacy compatibility only. Leave unset on new deployments when using the modern secret key.
# JOINHOOK_COMMERCE_SUPABASE_SERVICE_ROLE_KEY=LEGACY_SERVICE_ROLE_JWT

# Fulfillment secrets - SERVER ONLY; generate high-entropy random values
JOINHOOK_DOWNLOAD_TOKEN_SECRET=GENERATE_RANDOM_SECRET
JOINHOOK_DOWNLOAD_IP_HASH_SALT=GENERATE_RANDOM_SALT
JOINHOOK_DOWNLOAD_TTL_HOURS=72
JOINHOOK_DOWNLOAD_MAX_USES=3

# Purchase recovery - SERVER ONLY. Recovery uses its own secret, never the
# download-token secret. The email webhook can point to n8n or another approved
# transactional email service; no raw recovery token is stored in Postgres.
JOINHOOK_RECOVERY_TOKEN_SECRET=GENERATE_ANOTHER_RANDOM_SECRET
JOINHOOK_RECOVERY_TTL_MINUTES=30
JOINHOOK_RECOVERY_MAX_REQUESTS_15M=5
JOINHOOK_TRANSACTIONAL_EMAIL_WEBHOOK_URL=https://YOUR_PRIVATE_EMAIL_WEBHOOK
JOINHOOK_TRANSACTIONAL_EMAIL_WEBHOOK_SECRET=GENERATE_WEBHOOK_AUTH_SECRET

# Private product package. Keep outside public_html and outside the repository.
JOINHOOK_GASTRO_EXPRESS_PRIVATE_FILE=/home/joinhook/private-products/control-express/control-gastronomico-express.zip

# Private JoinHook Control Plane read access for Commerce health/metrics.
JOINHOOK_CP_COMMERCE_TOKEN=GENERATE_RANDOM_SERVER_TOKEN

# Historical compatibility only. Do not introduce CGE-prefixed variables in new deployments.
# NEXT_PUBLIC_CGE_CHECKOUT_ENABLED=true
# NEXT_PUBLIC_CGE_CHECKOUT_URL=https://LEGACY_CHECKOUT_URL
